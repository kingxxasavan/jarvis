# Copy to .env.local for local dev. On Vercel, add the same names under
# Project > Settings > Environment Variables.

# Supabase (Project Settings > API). The publishable key is public by design.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The only account allowed in. Must match the user you create in Supabase Auth.
OWNER_EMAIL=you@example.com
# Your display name and timezone, used by the persona and for dates.
OWNER_NAME=Savan
OWNER_TIMEZONE=America/New_York

# Brain: NVIDIA NIM first, Ollama Cloud when NIM fails. Either alone also works.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_EMBED_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v1
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b

# 32 random bytes, base64. Encrypts the arkia.buzz token at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# arkia.buzz Firebase web config. Public values (the same ones the arkia site
# ships to every browser); access is decided by its database rules.
NEXT_PUBLIC_ARKIA_API_KEY=AIzaSyC3e8T0nsoyey0EA9ozQbt9o5THI4pGzng
NEXT_PUBLIC_ARKIA_AUTH_DOMAIN=arikia.firebaseapp.com
NEXT_PUBLIC_ARKIA_PROJECT_ID=arikia
NEXT_PUBLIC_ARKIA_DATABASE_URL=https://arikia-default-rtdb.firebaseio.com
