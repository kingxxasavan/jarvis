# Keys for Anexis. Every one is optional. Anexis runs without any of them:
# whatever needs a missing key just stays off, it never errors.
# After a change: anexis restart

# Ollama's hosted models (ollama.com/settings/keys). Easiest: anexis ollama cloud
# OLLAMA_API_KEY=

# Nvidia's hosted models (free at build.nvidia.com)
# NVIDIA_API_KEY=

# Canvas, the school site (Canvas: Account, Settings, New Access Token)
# CANVAS_URL=https://yourschool.instructure.com
# CANVAS_TOKEN=

# Claude Code with an API key, if you do not sign in with `claude` instead
# ANTHROPIC_API_KEY=

# More tools (each turns on one tool server from tools.yaml)
# GITHUB_TOKEN=
# NOTION_TOKEN=
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# FIRECRAWL_API_KEY=
# EXA_API_KEY=
